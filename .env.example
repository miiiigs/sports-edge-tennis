TENNIS_ENVIRONMENT=development
TENNIS_DATABASE_URL=

# Unified Sports Edge UI - read-only Football integration.
# The Football platform stays a separate runtime and database. The Tennis-hosted
# UI calls it server-to-server only. Leave the base URL empty to show a clean
# "not configured" state; never point tests at production.
SPORTS_EDGE_FOOTBALL_BASE_URL=
# Optional read-only integration credential (Bearer token). Never rendered into
# HTML or browser JavaScript.
SPORTS_EDGE_CLIENT_API_TOKEN=
# Optional bounded request timeout in seconds (default 4.0).
SPORTS_EDGE_FOOTBALL_TIMEOUT_SECONDS=4.0
