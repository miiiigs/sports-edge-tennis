# Independent monitoring - prepared deployment configuration.
#
# This file contains variable NAMES only. Never commit a real ping key, check
# UUID or notifier URL. Values belong in the hosting provider's secret store.
#
# Status: prepared, not applied. See
# docs/operations/INDEPENDENT_MONITORING_ADAPTER_20261127.md

TENNIS_HEALTHCHECKS_ENABLED=0
TENNIS_HEALTHCHECKS_BASE_URL=https://hc-ping.com

# Either a per-stream UUID:
# TENNIS_HEALTHCHECKS_<STREAM>_UUID=<server-side check uuid>
# or the project ping key plus a per-stream slug:
TENNIS_HEALTHCHECKS_PING_KEY=
TENNIS_HEALTHCHECKS_SLUG=

TENNIS_HEALTHCHECKS_LIVE_RUNNER_SLUG=tennis-live-runner
TENNIS_HEALTHCHECKS_FIXTURE_DISCOVERY_SLUG=tennis-fixture-discovery
TENNIS_HEALTHCHECKS_FORECAST_GENERATION_SLUG=tennis-forecast-generation
TENNIS_HEALTHCHECKS_BOOKMAKER_ACQUISITION_SLUG=tennis-bookmaker-acquisition
TENNIS_HEALTHCHECKS_INDEPENDENT_ARCHIVAL_SLUG=tennis-independent-archival
TENNIS_HEALTHCHECKS_OFFICIAL_SETTLEMENT_SLUG=tennis-official-settlement
TENNIS_HEALTHCHECKS_BOOKMAKER_SETTLEMENT_SLUG=tennis-bookmaker-settlement
TENNIS_HEALTHCHECKS_PROSPECTIVE_CANDIDATE_SLUG=tennis-prospective-candidate

# Durable volume for state and receipts (owner-provisioned).
TENNIS_MONITORING_STATE_PATH=/data/monitoring-state.json
TENNIS_MONITORING_RECEIPT_DIR=/data/receipts
